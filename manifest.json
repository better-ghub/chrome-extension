{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Better GHub"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pulls*"],
      "js": [
        "src/constants.js",
        "src/utils/octicons.js",
        "src/utils/token-manager.js",
        "src/utils/api-metrics.js",
        "src/utils/i18n.js",
        "src/utils/dom-helpers.js",
        "src/utils/cache.js",
        "src/api/github-rest.js",
        "src/api/github-graphql.js",
        "src/ui/tooltip.js",
        "src/ui/loader.js",
        "src/ui/activity-element.js",
        "src/ui/version-badge.js",
        "src/services/pr-analyzer.js",
        "src/services/pr-processor.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/constants.js",
        "src/utils/octicons.js",
        "src/utils/token-manager.js",
        "src/utils/api-metrics.js",
        "src/utils/i18n.js",
        "src/utils/dom-helpers.js",
        "src/utils/cache.js",
        "src/api/github-rest.js",
        "src/api/github-graphql.js",
        "src/ui/tooltip.js",
        "src/ui/activity-element.js",
        "src/services/pr-analyzer.js",
        "src/dashboard.js"
      ],
      "css": ["src/dashboard-styles.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ]
}


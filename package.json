{
  "name": "better-ghub",
  "version": "0.1.0",
  "description": "Chrome extension that enhances GitHub Pull Request workflow",
  "scripts": {
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate-manifest": "node scripts/validate-manifest.js",
    "check-size": "node scripts/check-size.js"
  },
  "keywords": [
    "chrome-extension",
    "github",
    "pull-requests",
    "productivity"
  ],
  "author": "Better GHub Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/better-ghub/chrome-extension.git"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/auth/oauth.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    }
  }
}


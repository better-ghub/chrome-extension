{
  "name": "better-ghub",
  "version": "0.2.0",
  "description": "Chrome extension that enhances GitHub Pull Request workflow",
  "scripts": {
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ popup/ options/ --ext .ts",
    "lint:fix": "eslint src/ popup/ options/ --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate-manifest": "node scripts/validate-manifest.js",
    "check-size": "node scripts/check-size.js"
  },
  "keywords": [
    "chrome-extension",
    "github",
    "pull-requests",
    "productivity"
  ],
  "author": "Better GHub Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/better-ghub/chrome-extension.git"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.0"
  }
}
